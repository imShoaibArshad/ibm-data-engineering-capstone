# ---------------------------------------------------------------------------
# Data zones -- regenerated by the pipeline. Raw sources are tens of MB
# (the UCI workbook alone is 45 MB), so they must never enter git.
#
# data/reports is deliberately NOT ignored: the charts and dashboard are only
# ~220 KB and they are the visible evidence that the pipeline works, so they
# stay in the repo and render in the README without anyone running anything.
# ---------------------------------------------------------------------------
data/raw/*
data/staging/*
data/warehouse/*
data/marts/*
!data/**/.gitkeep

# Python
.venv/
venv/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
build/
dist/

# OS / editor noise
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Local secrets / environment overrides
.env
.env.*
